# ── Momentum Sniper — Frankfurt VPS production template ──
SNIPER_DRY_RUN=1
SNIPER_DB=/opt/sniper/sniper.db
SNIPER_QUOTE_SIZE=1000
SNIPER_BIND_HOST=0.0.0.0

# Dashboard security (rotate before production)
SNIPER_DASHBOARD_KEY=change-me-strong-key
SNIPER_JWT_SECRET=change-me-jwt-secret-32chars-min
SNIPER_MASTER_KEY=

# Exchange API (live mode only — keep empty for paper trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_KEY_ENC=
BINANCE_API_SECRET_ENC=

# Momentum engine tuning
MOM_BASE_SCORE=2.0
MOM_MAX_HOLD_SEC=300
MOM_IDLE_RELAX=1.2
ARB_MIN_DEPTH_USDT=300
ARB_IDLE_RELAX_SEC=900

# Runtime
SNIPER_UVLOOP=1
SNIPER_RATE_LIMIT=60/minute
